REFORGE_HOST=127.0.0.1
REFORGE_PORT=8787
REFORGE_TIMEZONE=Europe/Moscow
REFORGE_DATA_DIR=./data
# Required: at least 32 characters. Used to authenticate API requests.
REFORGE_TOKEN=
# Required: exactly 64 hex characters (32 bytes). Never lose or rotate without migrating backups.
REFORGE_BACKUP_KEY=
# Optional Telegram notification destination.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# local, s3, or sftp. A local encrypted copy is retained in every mode.
REFORGE_STORAGE=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=backup
SFTP_KEY_PATH=
# Must already exist on the SFTP host.
SFTP_DIRECTORY=/backups/reforge
